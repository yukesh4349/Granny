# Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase Postgres Connection String)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres?schema=public"

# Supabase REST API & Service Credentials
SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Auth Secret
JWT_SECRET="supersecret_jwt_key_change_in_production"
JWT_EXPIRATION="7d"

# AI Service URL
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
