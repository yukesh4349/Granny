# ═════════════════════════════════════════════════════════════════
# GRANNY: AI-Powered Cognitive Gaming & Memory App for Elderly Care
# All services use 100% Free Tiers — No credit card required.
# ═════════════════════════════════════════════════════════════════

# 1. Supabase (Free Tier: Postgres + pgvector + Auth + Edge Functions + Storage)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Groq Cloud (Free Tier: Ultra-fast Llama 3.3 70B & Whisper STT - 4 Key Pool)
# Get free keys from: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY_1=gsk_your_groq_free_api_key_1
EXPO_PUBLIC_GROQ_API_KEY_2=gsk_your_groq_free_api_key_2
EXPO_PUBLIC_GROQ_API_KEY_3=gsk_your_groq_free_api_key_3
EXPO_PUBLIC_GROQ_API_KEY_4=gsk_your_groq_free_api_key_4
VITE_GROQ_API_KEY_1=gsk_your_groq_free_api_key_1
VITE_GROQ_API_KEY_2=gsk_your_groq_free_api_key_2
VITE_GROQ_API_KEY_3=gsk_your_groq_free_api_key_3
VITE_GROQ_API_KEY_4=gsk_your_groq_free_api_key_4

# 3. Google Gemini (Free Tier: Generous quota fallback LLM)
# Get free key from: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSy_your_free_gemini_api_key

# 4. Pexels API (Free Tier: Curated Real Photos for Cognitive Games)
# Get free key from: https://www.pexels.com/api/
EXPO_PUBLIC_PEXELS_API_KEY=your_pexels_api_key

# 5. Pixabay API (Free Tier: Fallback Photo Catalog)
# Get free key from: https://pixabay.com/api/docs/
EXPO_PUBLIC_PIXABAY_API_KEY=your_pixabay_api_key

# Note: DiceBear (avatars) and Pollinations.ai (scene illustrations)
# require ZERO API keys and work out of the box via direct URLs.
