# ============================================================================
# Granny — Environment Configuration
# ============================================================================

# Application
NODE_ENV=development
PORT=4000
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# API URLs (for frontend)
VITE_API_URL=http://localhost:4000/api
VITE_AI_URL=http://localhost:8000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elderly_ai?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="supersecret_jwt_key_change_in_production"
JWT_EXPIRATION="7d"

# AI Services & LLM
AI_SERVICE_URL="http://localhost:8000"
OPENAI_API_KEY="your-openai-api-key"
ELEVENLABS_API_KEY="your-elevenlabs-key"
HUGGINGFACE_API_TOKEN="your-hf-token"

# Voice & Speech Service
SPEECH_RECOGNITION_MODEL="whisper-large-v3"
TTS_ENGINE="elevenlabs"
DEFAULT_LANGUAGE="en"

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
